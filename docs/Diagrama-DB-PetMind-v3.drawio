        <mxCell id="title" value="Modelo relacional PetMind — v3 (mínimo viable)" style="text;html=1;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#0B6B67;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="14 tablas · 27 relaciones · 7 módulos.  Sirve las mismas 42 pantallas que la v2 con 12 tablas menos: las relaciones 1:1 y las de cardinalidad fija se absorbieron como columnas." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="2000" height="40" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Cómo leer el diagrama&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#0B6B67&quot;&gt;PK&lt;/b&gt; · llave primaria (subrayada)&lt;br&gt;&lt;b style=&quot;color:#C4523A&quot;&gt;FK&lt;/b&gt; · llave foránea (cursiva)&lt;br&gt;(NULL) · el campo admite vacío&lt;br&gt;(UNIQUE) · valor irrepetible&lt;br&gt;&lt;br&gt;&lt;b&gt;Archivos&lt;/b&gt; es la tabla transversal de medios: galería de la mascota, fotos del hogar en la solicitud, evidencia del reporte y las imágenes de antes y después de campañas e historias. Solo una de sus cinco FK viene llena.&lt;br&gt;&lt;br&gt;&lt;b&gt;Favoritos&lt;/b&gt; sigue la misma regla con sus tres FK." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#D7DCE3;align=left;verticalAlign=top;spacing=12;fontSize=12;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="2260" y="520" width="270" height="300" as="geometry"/></mxCell>
